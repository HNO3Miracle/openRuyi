From: misaka00251 <liuxin@iscas.ac.cn>
Date: Wed, 23 Sep 2026 13:45:10 +0800
Subject: [PATCH] Use system python clang

---
 setup.py | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/setup.py b/setup.py
index 6b2c8b841..eb6648b14 100755
--- a/setup.py
+++ b/setup.py
@@ -540,7 +540,10 @@ def get_requires_for_build_wheel(config_settings=None):
         #print(f'OpenBSD: libclang not available via pip; assuming `pkg_add py3-llvm`.')
         pass
     else:
-        ret.append('libclang')
+        # openRuyi uses the Python bindings shipped with the system LLVM/Clang
+        # toolchain instead of PyPI's libclang package, which bundles its own
+        # native libclang.
+        pass
     if msys2():
         #print(f'msys2: pip install of swig does not build; assuming `pacman -S swig`.')
         pass
