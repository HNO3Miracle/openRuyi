From 7f5e19dff8e688fba72f0dfd7ad5ecbda92ed6ef Mon Sep 17 00:00:00 2001
From: misaka00251 <liuxin@iscas.ac.cn>
Date: Wed, 23 Sep 2026 14:14:50 +0800
Subject: [PATCH] scripts/wrap: resolve forward declarations before inspecting
 structs

scripts/wrap: resolve forward declarations before inspecting structs

Newer libclang versions may return a forward declaration from
Type.get_declaration() even when the complete definition is available
in the translation unit.

Resolve declaration cursors to their definitions before inspecting
struct members or reference-counting fields.

Also inspect the record type of FIELD_DECL cursors when traversing
embedded structs and unions. This allows nested members such as
fz_stext_block.u.t.first_line to be found reliably.

This avoids relying on libclang's declaration and cursor traversal
behavior and fixes wrapper generation with newer system LLVM/Clang.

Signed-off-by: misaka00251 <liuxin@iscas.ac.cn>
---
 scripts/wrap/parse.py | 25 +++++++++++++++++++++++--
 1 file changed, 23 insertions(+), 2 deletions(-)

diff --git a/scripts/wrap/parse.py b/scripts/wrap/parse.py
index c3bd1278c..4d46b3e40 100644
--- a/scripts/wrap/parse.py
+++ b/scripts/wrap/parse.py
@@ -91,6 +91,19 @@ def get_children(cursor):
                 jlib.log( '{cursor.spelling=}')
             yield cursor
 
+def get_definition_cursor(cursor):
+    '''
+    Return the full definition for a declaration when libclang can resolve
+    one. Newer libclang versions can return a forward declaration from
+    Type.get_declaration() even when the definition is available in the
+    translation unit.
+    '''
+    if cursor is not None and not cursor.is_definition():
+        definition = cursor.get_definition()
+        if definition is not None and definition.is_definition():
+            return definition
+    return cursor
+
 def get_members( type_or_cursor, include_empty=False):
     '''
     Yields cursor for each member. Uses whichever of
@@ -116,11 +129,17 @@ def get_members( type_or_cursor, include_empty=False):
         cursor = type_or_cursor
     else:
         assert 0
-    if cursor.type.kind in (state.clang.cindex.TypeKind.TYPEDEF, state.clang.cindex.TypeKind.ELABORATED):
+    if (cursor.kind == state.clang.cindex.CursorKind.FIELD_DECL and cursor.type.kind in (state.clang.cindex.TypeKind.RECORD, state.clang.cindex.TypeKind.ELABORATED,)):
+        # For a field containing an embedded struct/union, inspect the
+        # declaration of the field's type rather than the FIELD_DECL itself.
+        cursor2 = cursor.type.get_declaration()
+    elif cursor.type.kind in (state.clang.cindex.TypeKind.TYPEDEF, state.clang.cindex.TypeKind.ELABORATED,):
         cursor2 = cursor.underlying_typedef_type.get_declaration()
     else:
         cursor2 = cursor
 
+    cursor2 = get_definition_cursor(cursor2)
+
     if 0:
         # Diagnostics to show the difference between
         # clang.cindex.Cursor.get_children() and
@@ -251,7 +270,9 @@ def has_refs( tu, type_):
                 if keep_fn_cursor:
                     if verbose:
                         jlib.log( 'There is a keep() fn for this type so it uses reference counting: {keep_name=}')
-                    base_type_cursor = get_base_type( type_).get_declaration()
+                    base_type_cursor = get_definition_cursor(
+                            get_base_type( type_).get_declaration())
+
                     if base_type_cursor.is_definition():
                         if verbose:
                             jlib.log( 'Type definition is available so we look for .refs member: {key=} {type_.spelling=} {fileline(base_type_cursor)=}')
