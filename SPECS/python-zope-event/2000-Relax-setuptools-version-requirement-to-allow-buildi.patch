From 3b3cb59fbd9c5bb14693e1b2c9566399fe593b24 Mon Sep 17 00:00:00 2001
From: misaka00251 <liuxin@iscas.ac.cn>
Date: Tue, 22 Sep 2026 16:33:56 +0800
Subject: [PATCH] Relax setuptools version requirement to allow building with
 newer setuptools

---
 pyproject.toml | 2 +-
 tox.ini        | 4 ++--
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/pyproject.toml b/pyproject.toml
index 1ee7782..ee2e98c 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -2,7 +2,7 @@
 # https://github.com/zopefoundation/meta/tree/master/src/zope/meta/pure-python
 [build-system]
 requires = [
-    "setuptools >= 78.1.1,< 82",
+    "setuptools",
     "wheel",
 ]
 build-backend = "setuptools.build_meta"
diff --git a/tox.ini b/tox.ini
index 9d66f6a..8611fca 100644
--- a/tox.ini
+++ b/tox.ini
@@ -19,7 +19,7 @@ usedevelop = true
 package = wheel
 wheel_build_env = .pkg
 deps =
-    setuptools >= 78.1.1,< 82
+    setuptools
 commands =
     zope-testrunner --test-path=src {posargs:-vc}
     sphinx-build -b doctest -d {envdir}/.cache/doctrees docs {envdir}/.cache/doctest
@@ -37,7 +37,7 @@ description = ensure that the distribution is ready to release
 basepython = python3
 skip_install = true
 deps =
-    setuptools >= 78.1.1,< 82
+    setuptools
     wheel
     twine
     build
-- 
2.55.0

