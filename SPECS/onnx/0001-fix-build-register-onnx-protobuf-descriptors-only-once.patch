From a787d9f025eae8d433813d9cb60cd3277141d3f7 Mon Sep 17 00:00:00 2001
From: "copilot-swe-agent[bot]" <198982749+Copilot@users.noreply.github.com>
Date: Mon, 27 Jul 2026 05:08:01 +0000
Subject: [PATCH 2/3] fix(build): link onnx_proto into onnx instead of
 duplicating its objects

Co-authored-by: justinchuby <11205048+justinchuby@users.noreply.github.com>
Signed-off-by: misaka00251 <liuxin@iscas.ac.cn>
---
 .github/workflows/main.yml | 13 +++++++++++++
 CMakeLists.txt             |  7 +++++--
 2 files changed, 20 insertions(+), 3 deletions(-)

diff --git a/.github/workflows/main.yml b/.github/workflows/main.yml
index 88dd821fe2d..c03427dc9e3 100644
--- a/.github/workflows/main.yml
+++ b/.github/workflows/main.yml
@@ -194,6 +194,19 @@ jobs:
           export LD_LIBRARY_PATH="./.setuptools-cmake-build/:$LD_LIBRARY_PATH"
           ./.setuptools-cmake-build/onnx_gtests
 
+      - name: Check that the generated protobuf objects are not duplicated
+        # The generated *.pb.cc objects must live in onnx_proto only. A second
+        # copy inside onnx makes any process that loads both libraries register
+        # onnx/onnx-ml.proto twice, which aborts protobuf with
+        # "File already exists in database" (issue #6094).
+        if: startsWith(matrix.os,'ubuntu') || matrix.os == 'macos-latest'
+        run: |
+          ar t .setuptools-cmake-build/libonnx.a > onnx_members.txt
+          if grep '\.pb\.cc\.o$' onnx_members.txt; then
+            echo "::error::libonnx contains a second copy of the generated protobuf objects; it must link onnx_proto instead"
+            exit 1
+          fi
+
       - name: Run C++ extension test
         if: (startsWith(matrix.os,'ubuntu') || matrix.os == 'macos-latest') && matrix.debug_build == 0 && matrix.protobuf_type == 'Internal'
         run: |
diff --git a/CMakeLists.txt b/CMakeLists.txt
index 584c0419a..81942ec96 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -415,8 +415,11 @@ endif()
 add_library(onnx_proto ${ONNX_PROTO_SRCS})
 add_onnx_global_defines(onnx_proto)
 
-add_library(onnx ${ONNX_SRCS} ${ONNX_PROTO_SRCS})
-add_dependencies(onnx onnx_proto)
+# Keep generated protobuf objects in onnx_proto only. Embedding a second copy
+# in onnx causes duplicate descriptor registration when both libraries are
+# loaded in the same process ("File already exists in database").
+add_library(onnx ${ONNX_SRCS})
+target_link_libraries(onnx PUBLIC onnx_proto)
 set_source_files_properties(${ONNX_SRCS} PROPERTIES CXX_VISIBILITY_PRESET hidden)
 add_onnx_global_defines(onnx)
 

