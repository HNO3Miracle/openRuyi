From e6c8bf2286ee4f4e3f5fd34687ab2c730e8b9754 Mon Sep 17 00:00:00 2001
From: misaka00251 <liuxin@iscas.ac.cn>
Date: Wed, 23 Sep 2026 12:20:41 +0800
Subject: [PATCH] build: build shared onnx libraries

Signed-off-by: misaka00251 <liuxin@iscas.ac.cn>
---
 CMakeLists.txt | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 81942ec96..fca259147 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -412,14 +412,16 @@ if(ONNX_USE_LITE_PROTO)
     set(LINKED_PROTOBUF_TARGET protobuf::libprotobuf-lite)
   endif()
 endif()
-add_library(onnx_proto ${ONNX_PROTO_SRCS})
+add_library(onnx_proto SHARED ${ONNX_PROTO_SRCS})
+set_target_properties(onnx_proto PROPERTIES VERSION ${ONNX_VERSION} SOVERSION ${ONNX_VERSION})
 add_onnx_global_defines(onnx_proto)
 
 # Keep generated protobuf objects in onnx_proto only. Embedding a second copy
 # in onnx causes duplicate descriptor registration when both libraries are
 # loaded in the same process ("File already exists in database").
-add_library(onnx ${ONNX_SRCS})
+add_library(onnx SHARED ${ONNX_SRCS})
 target_link_libraries(onnx PUBLIC onnx_proto)
+set_target_properties(onnx PROPERTIES VERSION ${ONNX_VERSION} SOVERSION ${ONNX_VERSION})
 set_source_files_properties(${ONNX_SRCS} PROPERTIES CXX_VISIBILITY_PRESET hidden)
 add_onnx_global_defines(onnx)
 
-- 
