From cb488e30e03ae223054018cf0b4a6ed248ba56ba Mon Sep 17 00:00:00 2001
From: HNO3Miracle <xiangao.or@isrc.iscas.ac.cn>
Date: Mon, 21 Sep 2026 05:37:54 +0800
Subject: [PATCH] tests: isolate file writer output

Write file writer test output under t.TempDir so stale files from earlier
or concurrent runs cannot affect which rotated output the test reads.

Signed-off-by: HNO3Miracle <xiangao.or@isrc.iscas.ac.cn>
---
 file_test.go | 11 ++---------
 1 file changed, 2 insertions(+), 9 deletions(-)

diff --git a/file_test.go b/file_test.go
index 4b6c760..16264e2 100644
--- a/file_test.go
+++ b/file_test.go
@@ -9,8 +9,8 @@ import (
 )
 
 func TestFileWriter(t *testing.T) {
-	const filename string = "file-output.log"
 	const text string = "hello file writer!\n"
+	filename := filepath.Join(t.TempDir(), "file-output.log")
 
 	w := &FileWriter{
 		Filename: filename,
@@ -23,7 +23,7 @@ func TestFileWriter(t *testing.T) {
 	// _ = w.Rotate()
 	w.Close()
 
-	matches, err := filepath.Glob("file-output.*.log")
+	matches, err := filepath.Glob(filepath.Join(filepath.Dir(filename), "file-output.*.log"))
 	if err != nil {
 		t.Fatalf("filepath glob error: %+v", err)
 	}
@@ -39,13 +39,6 @@ func TestFileWriter(t *testing.T) {
 	if string(data) != text {
 		t.Fatalf("read file content mismath: data=[%s], text=[%s]", data, text)
 	}
-
-	err = os.Remove(matches[0])
-	if err != nil {
-		t.Fatalf("os remove %s error: %+v", matches[0], err)
-	}
-
-	os.Remove(filename)
 }
 
 func TestFileWriterStderr(t *testing.T) {
